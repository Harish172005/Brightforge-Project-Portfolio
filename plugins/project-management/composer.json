{
    "name": "brightforge/project-management",
    "description": "A custom WordPress project management plugin.",
    "type": "wordpress-plugin",
    "require": {
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Brightforge\\ProjectManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Brightforge\\ProjectManager\\Tests\\": "tests/"
        }
    }
}